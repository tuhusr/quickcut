{
  "name": "quickcut",
  "productName": "Quickcut",
  "version": "0.1.4",
  "description": "Quick, simple video editor: drop clips in, trim, merge, save.",
  "author": "Quickcut",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "electron build/render-icon.js",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File release.ps1",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File release.ps1 -Publish"
  },
  "build": {
    "appId": "app.quickcut.editor",
    "productName": "Quickcut",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Quickcut-Setup-${version}.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quickcut",
      "runAfterFinish": true,
      "uninstallDisplayName": "Quickcut",
      "deleteAppDataOnUninstall": false
    },
    "copyright": "Quickcut",
    "publish": [
      {
        "provider": "github",
        "owner": "tuhusr",
        "repo": "quickcut",
        "releaseType": "release"
      }
    ],
    "fileAssociations": [
      {
        "ext": "qcut",
        "name": "Quickcut project",
        "description": "Quickcut project",
        "icon": "build/icon.png"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "repository": "github:tuhusr/quickcut"
}
